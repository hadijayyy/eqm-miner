# ─── Required ────────────────────────────────────────────────────────────────

# Solana RPC endpoint (mainnet-beta)
RPC_URL=https://api.mainnet-beta.solana.com

# Wallet private key (base58 or JSON array).
# !! Use a dedicated mining wallet — NOT your main wallet !!
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# EQM mining program ID (on-chain program that accepts mine() calls)
PROGRAM_ID=YOUR_PROGRAM_ID_HERE

# ─── Optional ────────────────────────────────────────────────────────────────

# Backend: auto | cpu | cuda  (auto tries CUDA first, falls back to CPU)
MINER_BACKEND=auto

# Priority fee in micro-lamports (raise if transactions get dropped)
PRIORITY_FEE_MICRO_LAMPORTS=50000

# CPU settings
CPU_WORKERS=8
CPU_BATCH_SIZE=100000

# CUDA settings
# GPU_BATCH_SIZE: number of hashes per kernel launch (default 2^27 = 134217728)
GPU_BATCH_SIZE=134217728
# Path to compiled CUDA binary (default: ./bin/eqm-cuda)
CUDA_MINER_BIN=./bin/eqm-cuda
# CUDA compute architecture for build script (default: sm_75)
CUDA_ARCH=sm_75

# Set to false to mine only once (useful for testing)
KEEP_MINING=true
