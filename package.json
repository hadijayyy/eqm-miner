{
  "name": "eqm-mine",
  "version": "1.0.0",
  "description": "GPU-accelerated CLI miner for EQM token on Solana Mainnet (NVIDIA CUDA)",
  "main": "miner.js",
  "scripts": {
    "start":        "node miner.js --backend auto",
    "start:cpu":    "node miner.js --backend cpu",
    "start:cuda":   "node miner.js --backend cuda",
    "once":         "node miner.js --backend auto --once",
    "check":        "node check-state.js",
    "build:cuda":   "sh scripts/build-cuda.sh",
    "build:cuda:win": "powershell -ExecutionPolicy Bypass -File scripts/build-cuda.ps1"
  },
  "keywords": ["solana", "mining", "eqm", "cuda", "gpu", "cli"],
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bs58":            "^5.0.0",
    "dotenv":          "^16.4.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
